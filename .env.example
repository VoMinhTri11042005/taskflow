DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"
# Optional: direct (non-pooler) Postgres URL used only by deployment migrations.
# In Vercel, keep DATABASE_URL pooled for the app and set DIRECT_URL to Neon\'s direct URL.
DIRECT_URL=""
NODE_ENV="development"
# Canonical browser URL used in QR/invitation links. For Docker LAN access,
# use the server's reachable address, e.g. http://192.168.1.10:3002.
# NEXT_PUBLIC_* values are embedded during `docker compose build`.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Use a long random value in production. DATABASE_URL is only a fallback.
SESSION_SECRET="replace-with-a-long-random-secret"

# Leave blank to infer from the request protocol. Set false only for a trusted
# private HTTP LAN; use true (or leave blank behind HTTPS) for public hosting.
SESSION_COOKIE_SECURE=""

# Used only by `npm run setup:admin` (never commit real credentials).
ADMIN_EMAIL="admin@taskflow.vn"
ADMIN_PASSWORD="replace-with-a-strong-password"
