DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"
# Optional: direct (non-pooler) Postgres URL used only by deployment migrations.
# In Vercel, keep DATABASE_URL pooled for the app and set DIRECT_URL to Neon\'s direct URL.
DIRECT_URL=""
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Use a long random value in production. DATABASE_URL is only a fallback.
SESSION_SECRET="replace-with-a-long-random-secret"

# Used only by `npm run setup:admin` (never commit real credentials).
ADMIN_EMAIL="admin@taskflow.vn"
ADMIN_PASSWORD="replace-with-a-strong-password"
